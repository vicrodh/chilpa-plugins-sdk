#!/usr/bin/env python3
"""Copy reviewed wiki sources into a clean Git wiki checkout."""

import pathlib
import re
import subprocess
import sys


def main() -> int:
    if len(sys.argv) != 2:
        print("usage: tools/sync-wiki <clean wiki checkout>", file=sys.stderr)
        return 2
    target = pathlib.Path(sys.argv[1]).resolve()
    source = pathlib.Path(__file__).resolve().parent.parent / "wiki"
    if not (target / ".git").is_dir():
        print(f"sync-wiki: {target} is not a Git checkout", file=sys.stderr)
        return 2
    remote = subprocess.run(
        ["git", "-C", str(target), "remote", "get-url", "origin"],
        capture_output=True, text=True, check=True,
    ).stdout.strip()
    if not remote.endswith(".wiki.git"):
        print("sync-wiki: origin is not a wiki repository", file=sys.stderr)
        return 2
    status = subprocess.run(
        ["git", "-C", str(target), "status", "--porcelain"],
        capture_output=True, text=True, check=True,
    ).stdout
    if status:
        print("sync-wiki: checkout has local changes", file=sys.stderr)
        return 2
    for page in sorted(source.glob("*.md")):
        content = page.read_text()
        content = re.sub(
            r"\]\(([A-Za-z0-9_-]+)\.md\)",
            lambda match: f"](./{match.group(1)}/)",
            content,
        )
        (target / page.name).write_text(content)
        print(page.name)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
